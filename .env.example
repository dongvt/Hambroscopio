# Copy to .env and fill in. Never commit .env.
# Setup guides: docs/setup/

# --- App ---
# dev or prod
APP_ENV=dev
# true = log Sheets and Calendar writes instead of running them (reads still happen)
DRY_RUN=false
# trace | debug | info | warn | error | fatal (debug also logs full Claude prompts/responses)
LOG_LEVEL=info
# Local SQLite file (folder is created if missing)
SQLITE_PATH=./data/mealbot-dev.sqlite

# --- Discord (docs/setup/discord.md) ---
# Bot token from Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=
# Developer Portal -> General Information -> Application ID
DISCORD_APP_ID=
# Right-click server icon -> Copy Server ID
DISCORD_GUILD_ID=
# Right-click the meal channel -> Copy Channel ID
DISCORD_CHANNEL_ID=
# User IDs allowed to react and use /plan, comma-separated, no spaces
ALLOWED_USER_IDS=

# --- Claude (docs/setup/anthropic.md) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# none | low | medium | high
ANTHROPIC_EFFORT=medium

# --- Google (docs/setup/google-cloud.md, google-sheets.md, google-calendar.md) ---
# Auth uses Application Default Credentials (no key files). Locally:
#   gcloud auth application-default login --impersonate-service-account=<SA email>
# From the sheet URL: /spreadsheets/d/<THIS>/edit
SHEETS_SPREADSHEET_ID=
# Calendar settings -> Integrate calendar -> Calendar ID
CALENDAR_ID=
